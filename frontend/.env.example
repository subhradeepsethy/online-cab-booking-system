# Relative: the Vite dev server (and the production server) forward /api to the backend.
VITE_API_BASE_URL=/api
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Serve the dev site over HTTPS with a self-signed certificate. Phones only allow location
# (GPS) on secure pages, so turn this on to test the rider/driver apps from a phone.
DEV_HTTPS=false
