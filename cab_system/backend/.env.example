NODE_ENV=development
PORT=5000
# Exact website origin(s) allowed to call the API, comma-separated. Production requires https://.
CORS_ORIGIN=http://localhost:5173
# Long random string (32+ characters) used to sign login sessions. Required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change_me_to_a_long_random_string
# Folder for the SQLite database (cab.sqlite), uploaded documents and backups.
DATA_DIR=data
# Create demo rider/driver/admin accounts with known passwords. Local development only;
# the server refuses to start in production with this enabled.
SEED_DEMO_ACCOUNTS=true
# New drivers need admin approval (after document review) before they can go online.
REQUIRE_DRIVER_APPROVAL=true
# Optional admin account created on startup (10-digit mobile number, password of 12+ characters).
ADMIN_PHONE=
ADMIN_PASSWORD=
# Number of reverse proxies in front of the API (e.g. 1 on Render or behind Nginx).
TRUST_PROXY=0

# Phone verification by SMS at sign-up and for "forgot password".
REQUIRE_PHONE_VERIFICATION=true
# console = print codes in the server log and show them on screen (development only),
# msg91 or twilio = send real SMS (required in production).
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio sender number (+1...) or Messaging Service SID (MG...).
TWILIO_FROM=

# Built website to serve from this server. Defaults to ../frontend/dist in production only.
# STATIC_DIR=
